{
  "apps": [
    {
      "name": "web",
      "source": {"repository": "https://github.com/glenr-cloud/pulse", "provider": "github", "path": "api"},
      "dockerfile_path": "Dockerfile",
      "build_strategy": "dockerfile",
      "environments": [
        {
          "environment": "production",
          "git_ref": "main",
          "image": "registry.glenr.example/acme/web:1.0",
          "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
        }
      ]
    },
    {
      "name": "postgres",
      "source": {"repository": "https://hub.docker.com/_/postgres", "provider": "dockerhub"},
      "build_strategy": "image",
      "environments": [
        {
          "environment": "production",
          "image": "docker.io/library/postgres:16"
        }
      ]
    },
    {
      "name": "db",
      "managed": false,
      "environments": [
        {
          "environment": "production",
          "image": "",
          "version": "16"
        }
      ]
    }
  ]
}
